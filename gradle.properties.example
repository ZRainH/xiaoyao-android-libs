# 复制敏感项到 %USERPROFILE%\.gradle\gradle.properties（勿提交）

# —— GitHub Packages（可选）——
gpr.user=你的GitHub用户名
# gpr.key=ghp_xxx
gpr.repo.owner=ZRainH
gpr.repo.name=xiaoyao-android-libs

# —— Maven Central（Central Portal User Token）——
# 在 https://central.sonatype.com/ 生成 User Token
mavenCentralUsername=你的Token用户名
mavenCentralPassword=你的Token密码

# —— GPG 签名（Maven Central 必填）——
# signing.keyId=密钥ID后8位
# signing.password=GPG密码短语
# signing.secretKeyRingFile=C:\\Users\\你的用户名\\.gnupg\\secring.gpg
#
# 若没有 secring.gpg，可用内存密钥（推荐 CI）：
# signingInMemoryKey=（gpg --export-secret-keys --armor KEY_ID 的整段输出）
# signingInMemoryKeyId=密钥ID后8位
# signingInMemoryKeyPassword=GPG密码短语
